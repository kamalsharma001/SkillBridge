# ==================================================
# AI CAREER ENGINE - ENVIRONMENT & API KEY CONFIG
# ==================================================

# 1. Primary AI Provider (Gemini / NVIDIA Nemotron / OpenAI / Anthropic / Local Ollama)
LLM_PROVIDER=gemini

# Google Gemini Config
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_MODEL_FAST=gemini-2.0-flash
LLM_MODEL_MEDIUM=gemini-2.0-flash
GEMINI_THINKING_LEVEL=low
LLM_PARALLEL_REQUESTS=4
EMBEDDING_MODEL=text-embedding-004
ENABLE_LLM_SYNTHESIS=true

# Alternative: NVIDIA Nemotron Config (optional)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Alternative: OpenAI Config (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Deployment Environment Settings
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Data Source: in-memory verified benchmark dataset
DATA_SOURCE=json
