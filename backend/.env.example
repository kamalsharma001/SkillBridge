# ==================================================
# AI CAREER ENGINE - ENVIRONMENT & API KEY CONFIG
# ==================================================

# 1. Primary AI Provider (Gemini / NVIDIA Nemotron / OpenAI / Anthropic / Local Ollama)
LLM_PROVIDER=gemini

# Google Gemini Config (recommended six-perspective overview layer)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.7-flash
LLM_MODEL_FAST=gemini-3.7-flash
LLM_MODEL_MEDIUM=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low
LLM_PARALLEL_REQUESTS=6
EMBEDDING_MODEL=text-embedding-004
ENABLE_LLM_SYNTHESIS=true

# NVIDIA Nemotron Config (optional fallback provider)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# OpenAI Config (Alternative Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# Live Job Market Data Provider (Optional - for real-time job posting ingestion)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_api_key

# Deployment Environment Settings
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# ==================================================
# SAP HANA CLOUD CONNECTION
# ==================================================
HANA_HOST=your-hana-host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=your-password
HANA_ENCRYPT=true

# Data Source: "json" for local test fixtures, "hana" for SAP HANA Cloud
DATA_SOURCE=json
