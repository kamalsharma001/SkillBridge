# ==================================================
# SKILLBRIDGE ROOT ENVIRONMENT CONFIGURATION
# ==================================================

# AI LLM Provider Configuration (gemini / nvidia / openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# SAP HANA Cloud Database (Optional - set DATA_SOURCE=hana to enable)
DATA_SOURCE=json
HANA_HOST=your-hana-instance.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=your_hana_password
HANA_ENCRYPT=true

# Frontend Configuration
NEXT_PUBLIC_API_BASE=http://localhost:8000
